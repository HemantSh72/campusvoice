# Google AI Studio API key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Comma-separated model chain; first available model is tried first.
GEMINI_MODEL_CHAIN=gemini-3.1-flash-lite,gemini-3.5-flash-lite

# Optional exact Gemma model ID. Empty means disabled.
GEMMA_MODEL=

# Daily request caps per model (UTC day).
LLM_DAILY_CAP_PER_MODEL=450

# MongoDB Atlas: https://cloud.mongodb.com
# Empty is allowed only for local development and tests.
MONGODB_URI=
MONGODB_DB=campusvoice

# Telegram bot token from @BotFather and channel ID such as @channelname.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Admin PIN for the dashboard resolve action. Empty disables resolution.
ADMIN_PIN=

# Fixed-window per-IP limits. Shared venue IPs get a higher default.
RATE_LIMIT_PER_MIN=40
RATE_LIMIT_PER_DAY=1000

# Public Telegram channel URL shown in the UI; not a secret.
VITE_TELEGRAM_CHANNEL_URL=
