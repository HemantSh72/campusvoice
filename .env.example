# Copy to .env.local for local development. Never commit .env.local.
# Google AI Studio API key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Comma-separated Gemini model IDs, tried in this order.
GEMINI_MODEL_CHAIN=gemini-3.1-flash-lite,gemini-3.5-flash-lite

# Optional Gemma model ID. Empty means skip Gemma.
GEMMA_MODEL=

# Per-model UTC-day request caps. Gemma uses its own cap.
LLM_DAILY_CAP_PER_MODEL=450
GEMMA_DAILY_CAP=5000

# MongoDB Atlas connection string. Empty uses in-memory storage locally only.
MONGODB_URI=
MONGODB_DB=campusvoice

# Telegram bot token from @BotFather and target channel/chat ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Admin PIN for resolving tickets. Empty disables resolution.
ADMIN_PIN=

# Public channel link shown in the frontend (not a secret).
VITE_TELEGRAM_CHANNEL_URL=

# Shared-IP friendly limits; LLM caps are the actual quota guard.
RATE_LIMIT_PER_MIN=40
RATE_LIMIT_PER_DAY=1000
