# ─── LLM ───────────────────────────────────────────────────────────────────
# Google Gemini API key — get it at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Primary model (default: gemini-2.5-flash-lite)
GEMINI_MODEL=gemini-2.5-flash-lite

# Fallback model used if primary fails (default: gemini-2.5-flash)
GEMINI_FALLBACK_MODEL=gemini-2.5-flash

# Max LLM calls per UTC day before falling back to rule-based parser (default: 150)
LLM_DAILY_BUDGET=150

# ─── DATABASE ───────────────────────────────────────────────────────────────
# MongoDB Atlas connection string — get it at https://cloud.mongodb.com
# Leave empty for local dev (uses in-memory store with a warning)
MONGODB_URI=

# Database name (default: campusvoice)
MONGODB_DB=campusvoice

# ─── TELEGRAM ───────────────────────────────────────────────────────────────
# Telegram bot token — create a bot via @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# Telegram chat ID or @channelname to send alerts to
TELEGRAM_CHAT_ID=

# ─── ADMIN ──────────────────────────────────────────────────────────────────
# PIN to resolve tickets via the dashboard (leave empty to disable resolve endpoint)
ADMIN_PIN=

# ─── RATE LIMITING ──────────────────────────────────────────────────────────
# Max voice requests per IP per minute (default: 40)
RATE_LIMIT_PER_MIN=40

# Max voice requests per IP per day (default: 1000)
RATE_LIMIT_PER_DAY=1000

# ─── FRONTEND (public) ──────────────────────────────────────────────────────
# Public Telegram channel URL shown as "Watch live alerts" button
VITE_TELEGRAM_CHANNEL_URL=
